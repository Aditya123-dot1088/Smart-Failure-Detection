# Copy this file to .env and fill in your real Postgres credentials.
# Either set DATABASE_URL, or set the individual PG* fields below — DATABASE_URL wins if both are set.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Used only if DATABASE_URL is not set:
PGHOST=localhost
PGPORT=5432
PGDATABASE=project_intake
PGUSER=postgres
PGPASSWORD=

# Set to "true" if your provider requires SSL (most hosted DBs — Neon, Supabase, RDS — do)
PGSSL=false

# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend dev/prod URLs)
CORS_ORIGIN=http://localhost:5173

# --- Milestone 3: Strategic Reasoning AI provider ---------------------------
# Leave AI_PROVIDER and both keys blank to use the built-in deterministic
# reasoning engine — no key required, everything still works end to end.
# Set AI_PROVIDER to "gemini" or "openai" to pick one explicitly, or just
# fill in one key below and it will be auto-detected.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
